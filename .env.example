# Every key is required unless marked optional. A missing key fails at boot rather than
# silently connecting somewhere unexpected.
# Reference: ../docs/03-engineering/environments-and-configuration.md

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Atlas connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net/
# URL-encode the password. Add your IP to the Atlas access list.
MONGODB_URI=
# Use your own database on the dev cluster — seed:demo drops and recreates it.
MONGODB_DB_NAME=agencyboost

# Rotate the access and refresh secrets independently.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# File storage: Google Cloud Storage (ADR-0153). Optional locally — leave GCS_BUCKET empty and the
# API boots; every upload and file link then answers 503 STORAGE_NOT_CONFIGURED, and seed:demo
# skips its demonstration PDFs. Required in staging and production.
#
# To work on uploads, point it at the dev bucket and sign in as the dev signer — no key file:
#   gcloud auth application-default login --impersonate-service-account=<dev-signer>@<project>.iam.gserviceaccount.com
# (your account needs roles/iam.serviceAccountTokenCreator on that service account).
GCS_BUCKET=
# Optional: the bucket's project, if Application Default Credentials cannot tell.
GCS_PROJECT_ID=
# The first segment of every key: dev | staging | prod. "prod" in production and nowhere else.
STORAGE_KEY_PREFIX=dev

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="AgencyBoost <no-reply@agencyboost.app>"
# How long the relay may take to answer a dial, or to greet, in ms (1000–60000). Mail is sent
# after a save has answered, so this bounds how long a delivery stays "pending", not a save.
SMTP_TIMEOUT_MS=5000
# smtp | log. "log" prints the message instead of sending it, for local work with no
# mail catcher. Refused in production — see ADR-0019.
MAIL_TRANSPORT=log

# Used to build verification and password-reset links.
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Where a shared invite link points. The app's origin, not this API's — somebody opening
# an invite lands on a page, not an endpoint.
APP_ORIGIN=http://localhost:3000

# Whether a browser treats a call to this API as cross-site — true when the app and the
# API sit on different registrable domains, which is the Vercel staging shape (ADR-0041).
# It switches the refresh cookie to "SameSite=None; Secure"; left false, that cookie is
# never sent cross-site and every refresh fails after an apparently successful login.
# Requires an https APP_ORIGIN: boot refuses the combination otherwise.
COOKIE_CROSS_SITE=false

RATE_LIMIT_LOGIN_PER_15M=5

# How many proxies stand in front of the API: false (nothing in front, as locally) or a hop
# count. 1 on the VMs, behind Caddy. Without it every client has Caddy's IP, so one person's
# wrong passwords lock everybody out of login. "true" is refused: it lets a client choose its
# own IP with an X-Forwarded-For header. Optional locally; staging and production refuse to
# boot without it.
TRUST_PROXY=false

# Only the default applied when Super Admin creates a tenant without specifying one.
# Runtime code reads kpm.timezone, never this value.
DEFAULT_TENANT_TIMEZONE=Asia/Jakarta
