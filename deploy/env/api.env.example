# One environment's API configuration: the whole content of the Secret Manager secret api-env-staging
# or api-env-prod (P18.7-T3, ADR-0152, ADR-0155). `bin/deploy.sh <env>` renders it to
# /opt/agencyboost/env/api-<env>.env (mode 0600) on every deploy of that environment, so a new version
# of the secret takes effect at that environment's next deploy. Fill one copy per environment.
#
# Fill a copy outside the repository, then
#   gcloud secrets versions add api-env-staging --project=<project> --data-file=api-staging.env
# and delete the copy. A filled copy is never committed (deploy/env/*.env is ignored).
#
# RAW FORMAT (compose `format: raw`). One KEY=value per line; the value is everything after the first
# "=", taken literally. No quotes, which would become part of the value. No "$" expansion. No comment
# after a value. Whole-line comments and blank lines are fine.
#
# Each <...> is yours to fill, and where staging and production differ both are named. A value left as
# <...> fails validation at boot, on purpose. deploy.sh also refuses, before anything moves, a secret
# with a <placeholder> left in it, and one whose NODE_ENV or MONGODB_DB_NAME is the other
# environment's. Every key: docs/03-engineering/environments-and-configuration.md.

# staging in api-env-staging, production in api-env-prod.
NODE_ENV=<staging|production>
PORT=3001
LOG_LEVEL=info

# This environment's own database and its own user, from the secret mongo-root (mongo.env.example),
# over the compose network. The user has readWrite on this database and nothing else, which is what
# keeps staging out of production's data on the shared VM (ADR-0155).
#   production: user agencyboost_prod,    database agencyboost
#   staging:    user agencyboost_staging, database agencyboost_staging
# The password is the matching MONGO_PROD_PASSWORD or MONGO_STAGING_PASSWORD: `openssl rand -hex 32`,
# because hex needs no URL-encoding inside this URI.
MONGODB_URI=mongodb://<agencyboost_prod|agencyboost_staging>:<password>@mongo:27017/<agencyboost|agencyboost_staging>?authSource=<agencyboost|agencyboost_staging>
MONGODB_DB_NAME=<agencyboost|agencyboost_staging>

# `openssl rand -base64 48` for each: different from each other, and from the other environment's.
JWT_ACCESS_SECRET=<openssl rand -base64 48>
JWT_REFRESH_SECRET=<openssl rand -base64 48, not the access secret>
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Google Cloud Storage (ADR-0153). No credentials here: the VM's service account, api-runtime, signs.
# staging: agencyboost-staging-assets    production: agencyboost-prod-assets
GCS_BUCKET=<agencyboost-staging-assets|agencyboost-prod-assets>
# staging: staging    production: prod. Production refuses any other value, and staging must say
# staging explicitly: the default is dev.
STORAGE_KEY_PREFIX=<staging|prod>
# Optional, and normally absent: the bucket's project, only if Application Default Credentials on the
# VM cannot tell (they can, from the metadata server). To set it, add a line GCS_PROJECT_ID=<project>.

# Mail (ADR-0182). MAIL_PROVIDER names the provider, and its preset fills the host, the port and TLS:
# write SMTP_HOST or SMTP_PORT only to override it. Every recipe, and how to test a change with
# bin/send-test-mail.sh: docs/03-engineering/email-delivery.md. MAIL_FROM is a real value: the <> in
# "AgencyBoost <address>" are the address's, and it is unquoted.
#
#   staging: Gmail, from the product's own account. MAIL_FROM must be that account, or Gmail rewrites
#            it and DMARC fails; the password is a Gmail App Password (2-Step Verification on), with or
#            without the spaces Google shows.
#     MAIL_PROVIDER=gmail
#     SMTP_USER=agencyboostid@gmail.com
#     SMTP_PASSWORD=<Gmail App Password>
#     MAIL_FROM=AgencyBoost <agencyboostid@gmail.com>
#   production: Amazon SES in Jakarta, out of the sandbox (ADR-0152 §9), until go-live chooses its
#            provider (ADR-0182); SES stays a preset either way.
#     MAIL_PROVIDER=ses
#     SMTP_USER=<SES SMTP user name>
#     SMTP_PASSWORD=<SES SMTP password>
#     MAIL_FROM=AgencyBoost <no-reply@agencyboost.id>
MAIL_PROVIDER=<gmail|ses>
SMTP_USER=<agencyboostid@gmail.com|SES SMTP user name>
SMTP_PASSWORD=<Gmail App Password|SES SMTP password>
MAIL_FROM=<AgencyBoost <agencyboostid@gmail.com>|AgencyBoost <no-reply@agencyboost.id>>
SMTP_TIMEOUT_MS=5000
# Optional: where replies go, when not to MAIL_FROM. To set it, add a line MAIL_REPLY_TO=<address>.
# A file written before MAIL_PROVIDER, with SMTP_HOST, SMTP_PORT and MAIL_TRANSPORT=smtp, still boots.

# The app's origin on Vercel, never this API's: every link an email carries is built from it.
# staging: https://staging.agencyboost.id    production: https://agencyboost.id
APP_ORIGIN=<https://staging.agencyboost.id|https://agencyboost.id>
# Exactly one origin, the app's. The other environment's origin must not be here: it is same-site.
CORS_ORIGINS=<the same as APP_ORIGIN>
# APP_BASE_URL is read by nothing (ADR-0182): leave it out. A file that still has it boots.
# The app and the API share the site agencyboost.id, so the refresh cookie stays SameSite=Lax.
COOKIE_CROSS_SITE=false
# One proxy in front of the API: Caddy.
TRUST_PROXY=1

RATE_LIMIT_LOGIN_PER_15M=5
DEFAULT_TENANT_TIMEZONE=Asia/Jakarta
