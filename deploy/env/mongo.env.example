# MongoDB's credentials: the whole content of the Secret Manager secret mongo-root (P18.4-T3,
# ADR-0152, ADR-0155). One MongoDB serves both environments on the shared VM, so there is one secret.
# bin/deploy.sh renders it once, to /opt/agencyboost/env/mongo.env (mode 0600), on the first deploy of
# either environment. Mongo reads it only when it initialises an empty data disk, so changing the
# secret later changes no password: rotating one is its own procedure
# (docs/03-engineering/deployment-gcp.md). deploy.sh refuses a version missing any key below.
#
# Raw format, as api.env.example describes. `openssl rand -hex 32` for each password.

# The administrator. Used by bin/backup.sh and by a person, never by an API.
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=<openssl rand -hex 32>

# Production's API user, created by mongo/init/01-app-users.js with readWrite on agencyboost only.
# The same password goes into MONGODB_URI in api-env-prod.
MONGO_PROD_USERNAME=agencyboost_prod
MONGO_PROD_PASSWORD=<openssl rand -hex 32>

# Staging's API user, with readWrite on agencyboost_staging only. The staging seed connects as this user,
# so it cannot touch production's database. The same password goes into MONGODB_URI in api-env-staging.
MONGO_STAGING_USERNAME=agencyboost_staging
MONGO_STAGING_PASSWORD=<openssl rand -hex 32>
