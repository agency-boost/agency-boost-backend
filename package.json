{
  "name": "agency-boost-backend",
  "version": "0.1.0",
  "private": true,
  "description": "AgencyBoost API — multi-tenant SaaS for insurance agency offices (KPM)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPattern='\\.spec\\.ts$' --testPathIgnorePatterns='\\.int\\.spec\\.ts$|\\.tenancy\\.spec\\.ts$'",
    "test:integration": "jest --testPathPattern='\\.int\\.spec\\.ts$'",
    "test:tenancy": "jest --testPathPattern='\\.tenancy\\.spec\\.ts$'",
    "test:coverage": "jest --coverage",
    "seed:demo": "ts-node -r tsconfig-paths/register src/seed/demo.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/mongoose": "^10.1.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/terminus": "^10.2.3",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.5.1",
    "luxon": "^3.5.0",
    "mongoose": "^8.9.5",
    "nestjs-pino": "^4.2.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ulid": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@angular-devkit/core>picomatch": ">=4.0.4",
      "@nestjs/cli>glob": ">=10.5.0",
      "@nestjs/config>lodash": ">=4.18.0",
      "@nestjs/platform-express>multer": ">=2.2.0",
      "@nestjs/swagger>js-yaml": ">=4.3.1",
      "@nestjs/swagger>lodash": ">=4.18.0",
      "external-editor>tmp": ">=0.2.6"
    }
  }
}
